{
  "name": "typenow",
  "version": "0.5.8",
  "description": "即刻对话 / TalkNow — local chat assistant · www.talknow.cn",
  "main": "./out/main/index.js",
  "author": "TalkNow",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "membership:server": "npm --prefix server start",
    "membership:dev": "npm --prefix server run dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "ensure-clean": "node scripts/ensure-clean-release.mjs",
    "ensure-sharp": "node scripts/ensure-sharp.mjs",
    "pack": "npm run ensure-sharp && npm run ensure-clean && npm run build && electron-builder --mac --dir",
    "dist": "npm run ensure-sharp && npm run ensure-clean && npm run build && electron-builder --mac",
    "pack:win": "npm run ensure-sharp && npm run ensure-clean && npm run build && electron-builder --win --dir",
    "dist:win": "npm run ensure-sharp && npm run ensure-clean && npm run build && electron-builder --win nsis --publish never",
    "dist:win:green": "npm run ensure-sharp && npm run ensure-clean && npm run build && electron-builder --win portable zip --publish never",
    "rebuild": "electron-rebuild -f -w better-sqlite3,uiohook-napi",
    "sync:plans": "node scripts/sync-plan-catalog.mjs",
    "postinstall": "(electron-rebuild -f -w better-sqlite3,uiohook-napi || true) && node scripts/ensure-sharp.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "active-win": "^8.2.1",
    "better-sqlite3": "^11.9.1",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "sharp": "0.32.6",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.typenow.app",
    "productName": "即刻对话",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.{node,dylib,dll}",
      "**/better-sqlite3/**/*",
      "**/active-win/**/*",
      "**/uiohook-napi/**/*",
      "**/@xenova/transformers/**/*",
      "**/onnxruntime-node/**/*",
      "**/sharp/**/*",
      "**/sharp/vendor/**/*",
      "**/ffmpeg-static/**/*"
    ],
    "npmRebuild": true,
    "afterPack": "./scripts/after-pack-verify-sharp.cjs",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "需要控制其他应用以将回复粘贴到聊天输入框。",
        "NSScreenCaptureDescription": "需要截取当前聊天窗口以识别对话内容。",
        "NSMicrophoneUsageDescription": "需要使用麦克风进行「即刻对话 / TalkNow」语音转文字。"
      }
    },
    "dmg": {
      "title": "即刻对话",
      "background": "resources/dmg-background.png",
      "contents": [
        {
          "x": 140,
          "y": 220,
          "type": "file"
        },
        {
          "x": 480,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 660,
        "height": 400
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-绿色版-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "即刻对话",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
