# 复制为 .env 后修改
PORT=8788
DATA_DIR=./data
# 开发态验证码（任意手机号可用此码登录）；生产请接短信并留空禁用固定码
DEV_LOGIN_CODE=888888
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME
# 上游默认（后台「模型路由」也可改；Key 和线上模型名勿提交仓库）
UPSTREAM_BASE_URL=https://api.siliconflow.cn/v1
UPSTREAM_API_KEY=
UPSTREAM_ASR_MODEL=
UPSTREAM_VISION_MODEL=
UPSTREAM_CHAT_MODEL=
# 会员页展示的线下付款说明
OPS_PAYMENT_HINT=请转账至对公账户（主体就绪后更新），备注你的手机号，并联系客服开通。
OPS_SUPPORT_CONTACT=客服微信：待填写
# Stripe Checkout（测试）。密钥只写本机 .env，勿提交。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://www.talknow.cn/subscribe/success/?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://www.talknow.cn/subscribe/
